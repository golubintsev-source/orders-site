{
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0" }]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }]
    },
    {
      "source": "/js/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/style.css",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }]
    },
    {
      "source": "/img/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    }
  ],
  "functions": {
    "api/supabase-proxy.js": {
      "maxDuration": 60
    },
    "api/secret-login.js": {
      "maxDuration": 30
    },
    "api/send-task-push.js": {
      "maxDuration": 30
    },
    "api/send-message-push.js": {
      "maxDuration": 30
    },
    "api/send-group-message-push.js": {
      "maxDuration": 30
    },

    "api/push-config.js": {
      "maxDuration": 10
    },
    "api/push-status.js": {
      "maxDuration": 10
    },
    "api/voice-assistant.js": {
      "maxDuration": 60
    },
    "api/voice-tts.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/new", "destination": "/index.html" },
    { "source": "/calculations", "destination": "/index.html" },
    { "source": "/excess", "destination": "/index.html" },
    { "source": "/tasks-all", "destination": "/index.html" },
    { "source": "/changes-all", "destination": "/index.html" },
    { "source": "/balance", "destination": "/index.html" },
    { "source": "/manager-salary", "destination": "/index.html" },
    { "source": "/route-sheet", "destination": "/index.html" },
    { "source": "/settings", "destination": "/index.html" },
    { "source": "/statistics", "destination": "/index.html" },
    { "source": "/statistics-balance", "destination": "/index.html" },
    { "source": "/debts", "destination": "/index.html" },
    { "source": "/order-tasks", "destination": "/index.html" },
    { "source": "/messages", "destination": "/index.html" },
    { "source": "/voice", "destination": "/index.html" },
    { "source": "/all", "destination": "/index.html" }
  ]
}
