{
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0" }]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }]
    }
  ],
  "functions": {
    "api/supabase-proxy.js": {
      "maxDuration": 60
    },
    "api/secret-login.js": {
      "maxDuration": 30
    },
    "api/send-task-push.js": {
      "maxDuration": 30
    },
    "api/push-config.js": {
      "maxDuration": 10
    },
    "api/push-status.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/new", "destination": "/index.html" },
    { "source": "/calculations", "destination": "/index.html" },
    { "source": "/tasks-all", "destination": "/index.html" },
    { "source": "/changes-all", "destination": "/index.html" },
    { "source": "/balance", "destination": "/index.html" },
    { "source": "/route-sheet", "destination": "/index.html" },
    { "source": "/settings", "destination": "/index.html" },
    { "source": "/statistics", "destination": "/index.html" },
    { "source": "/order-tasks", "destination": "/index.html" },
    { "source": "/all", "destination": "/index.html" }
  ]
}
